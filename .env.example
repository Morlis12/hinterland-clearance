# Base de données PostgreSQL
DATABASE_URL=postgres://hinterland:hinterland@localhost:5432/hinterland
# Mot de passe partagé pour l'accès à l'application (auth minimale, remplacée plus tard par Entra ID)
APP_PASSWORD=changez-moi
# Secret de signature du cookie de session (chaîne aléatoire longue)
APP_SESSION_SECRET=changez-moi-secret-tres-long-aleatoire
# Taille max d'import web en octets (défaut ~4 Mo)
# MAX_UPLOAD_BYTES=4718592
# Nombre max de lignes pour l'export CSV de la vue filtrée
# EXPORT_MAX_ROWS=20000
